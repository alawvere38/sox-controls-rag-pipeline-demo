# Copy to .env and fill in. .env is git-ignored — never commit real values.

# Public chat webhook of the n8n query workflow ("SOX RAG — 2. Query Agent (live)").
# In n8n: open the workflow -> When Chat Message Received node -> copy the public chat URL.
# Looks like: https://<instance>.app.n8n.cloud/webhook/c1833055-00a8-42f9-8c9e-d011b8ac6649/chat
N8N_CHAT_WEBHOOK_URL=

# OpenAI key for the LLM judge (groundedness + answer correctness, gpt-4o-mini).
OPENAI_API_KEY=
